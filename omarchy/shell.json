{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "viniabdalla.menu"
        },
        {
          "id": "omarchy.workspaces",
          "groups": [
            {
              "monitor": "eDP-1",
              "ids": [
                1,
                2
              ],
              "colorKey": "bright_foreground"
            }
          ]
        },
        {
          "id": "data-goblin.fileblade"
        },
        {
          "id": "viniabdalla.agenda"
        }
      ],
      "center": [
        {
          "id": "viniabdalla.indicators"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "mission_control_button",
          "type": "qml"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "viniabdalla.layout-manager"
        },
        {
          "id": "io.github.rawritude.floating-mode"
        },
        {
          "id": "jankeesvw.downloads"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "window-attention.indicator"
        }
      ],
      "right": [
        {
          "id": "io.github.tyrichards.tray",
          "hidden": [],
          "order": [
            "Claude_status_icon_1",
            "steam",
            "discord_status_icon_1",
            "omarchy.tailscale",
            "gladimdim.config-sync",
            "io.github.salemsayed.omaonedrive",
            "omarchy.monitor",
            "TelegramDesktop"
          ],
          "widgets": [
            {
              "entry": {
                "id": "omarchy.tailscale"
              },
              "listed": true
            },
            {
              "entry": {
                "id": "io.github.salemsayed.omaonedrive",
                "notifications": true,
                "panelStyle": "Full",
                "recentFileLimit": 20,
                "refreshIntervalSec": 30
              },
              "listed": true
            },
            {
              "entry": {
                "id": "omarchy.monitor"
              },
              "listed": true
            },
            {
              "entry": {
                "id": "gladimdim.config-sync"
              },
              "listed": true
            }
          ],
          "showTrayIcons": true
        },
        {
          "id": "viniabdalla.functions"
        },
        {
          "id": "viniabdalla.agents",
          "barStyle": "rings"
        },
        {
          "id": "stappmus.activity-monitor",
          "openExpanded": true
        },
        {
          "id": "gaming-cursor",
          "type": "qml"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "io.github.jordanneenan.simple-power-menu"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "bobbynicholas.omaland"
    },
    {
      "id": "ryenski.taildrop"
    },
    {
      "id": "io.github.andyweiboan.missioncontrol"
    },
    {
      "id": "io.github.silkvain.dockseid"
    },
    {
      "id": "ewweberlin.quickswitch"
    },
    {
      "id": "io.github.maajix.spotlight"
    },
    {
      "id": "omarchy.tailscale"
    },
    {
      "id": "io.github.salemsayed.omaonedrive"
    },
    {
      "id": "omarchy.monitor"
    },
    {
      "id": "gladimdim.config-sync"
    },
    {
      "id": "marcho78.titlebars"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "viniabdalla.menu"
  ]
}
