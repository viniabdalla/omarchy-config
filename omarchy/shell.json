{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "viniabdalla.menu"
        },
        {
          "id": "omarchy.workspaces",
          "groups": [
            {
              "monitor": "eDP-1",
              "ids": [
                1,
                2
              ],
              "colorKey": "bright_foreground"
            }
          ]
        },
        {
          "id": "data-goblin.fileblade"
        },
        {
          "id": "viniabdalla.agenda"
        }
      ],
      "center": [
        {
          "id": "viniabdalla.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "mission_control_button",
          "type": "qml"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "io.github.rawritude.floating-mode"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "gladimdim.config-sync"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "viniabdalla.functions"
        },
        {
          "id": "viniabdalla.agents"
        },
        {
          "id": "stappmus.activity-monitor",
          "openExpanded": true
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.salemsayed.omaonedrive",
          "refreshIntervalSec": 30,
          "recentFileLimit": 20,
          "panelStyle": "Full",
          "notifications": true
        },
        {
          "id": "gaming-cursor",
          "type": "qml"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "io.github.jordanneenan.simple-power-menu"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "bobbynicholas.omaland"
    },
    {
      "id": "ryenski.taildrop"
    },
    {
      "id": "io.github.andyweiboan.missioncontrol"
    },
    {
      "id": "io.github.silkvain.dockseid"
    },
    {
      "id": "ewweberlin.quickswitch"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "viniabdalla.menu"
  ]
}
