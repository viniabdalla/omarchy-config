{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "hoverOnly",
          "iconSize": 16,
          "persistentWorkspaces": 4
        }
      ],
      "center": [
        {
          "id": "viniabdalla.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "mission_control_button",
          "type": "qml"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "gladimdim.config-sync"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "viniabdalla.agents"
        },
        {
          "id": "stappmus.activity-monitor"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "gaming-cursor",
          "type": "qml"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "io.github.jordanneenan.simple-power-menu"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "ryenski.taildrop"
    },
    {
      "id": "io.github.silkvain.dockseid"
    },
    {
      "id": "io.github.deunnis.lacquer"
    }
  ]
}
