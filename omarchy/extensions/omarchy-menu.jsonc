{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  // Functions/Skills: atalhos pessoais em subpastas. Novas categorias entram
  // como "personal.<pasta>" e seus itens como "personal.<pasta>.<item>".
  "personal": {"icon":"","label":"Functions/Skills"},

  // Functions: funções de ~/.bashrc, abertas num terminal TUI. "bash -ic" é
  // necessário pois são funções de shell, não binários no PATH.
  "personal.functions": {"icon":"","label":"Functions"},
  "personal.functions.tropico-ssh": {"icon":"","label":"SSH Trópico","description":"ssh tropico (MagicDNS tropico-1)","action":"omarchy-launch-tui bash -ic 'tropico-ssh; exec bash'"},
  "personal.functions.herdr-tropico": {"icon":"","label":"Herdr Trópico","description":"herdr --remote ssh://tropico","action":"omarchy-launch-tui bash -ic 'herdr-tropico; exec bash'"},
  "personal.functions.stream-janaina": {"icon":"","label":"Stream Janaína","description":"moonlight stream (Desktop)","action":"omarchy-launch-tui bash -ic 'stream janaina; exec bash'"},

  // Omarchy: restarts de componentes. Shell usa setsid (o restart mata o
  // processo que roda a ação); audio/trackpad usam sudo, então abrem num TUI.
  "personal.omarchy": {"icon":"","label":"Omarchy"},
  "personal.omarchy.shell": {"icon":"","label":"Restart Shell","description":"omarchy restart shell (destrava painéis como o Omaland)","action":"setsid -f omarchy restart shell"},
  "personal.omarchy.hyprland": {"icon":"","label":"Reload Hyprland","description":"omarchy restart hyprctl","action":"omarchy restart hyprctl"},
  "personal.omarchy.hyprmoncfg": {"icon":"󰍹","label":"Restart hyprmoncfg","description":"systemctl --user restart hyprmoncfgd (destrava \"interactive preview belongs to another client\")","action":"systemctl --user restart hyprmoncfgd && notify-send 'hyprmoncfg' 'Daemon reiniciado. Reabra o hyprmoncfg.'"},
  "personal.omarchy.audio": {"icon":"","label":"Restart Audio","description":"omarchy restart audio (pede sudo)","action":"omarchy-launch-tui bash -c 'omarchy restart audio; read -n1 -p \"Enter para fechar\"'"},
  "personal.omarchy.bluetooth": {"icon":"","label":"Restart Bluetooth","description":"omarchy restart bluetooth","action":"omarchy restart bluetooth"},
  "personal.omarchy.wifi": {"icon":"","label":"Restart Wi-Fi","description":"omarchy restart wifi","action":"omarchy restart wifi"},
  "personal.omarchy.trackpad": {"icon":"","label":"Restart Trackpad","description":"omarchy restart trackpad (pede sudo)","action":"omarchy-launch-tui bash -c 'omarchy restart trackpad; read -n1 -p \"Enter para fechar\"'"},
  "personal.omarchy.hyprsunset": {"icon":"","label":"Restart Night Light","description":"omarchy restart hyprsunset","action":"omarchy restart hyprsunset"},
  "personal.omarchy.screensaver": {"icon":"󱄄","label":"Screensaver","description":"omarchy toggle screensaver (✓ = ligado)","action":"omarchy toggle screensaver","checked":"! omarchy-toggle-enabled screensaver-off"},
  "personal.omarchy.terminal": {"icon":"","label":"Reload Terminals","description":"omarchy restart terminal","action":"omarchy restart terminal"},
  "personal.omarchy.xcompose": {"icon":"","label":"Restart XCompose","description":"omarchy restart xcompose","action":"omarchy restart xcompose"},
  "personal.omarchy.herdr": {"icon":"","label":"Reload Herdr","description":"omarchy restart herdr","action":"omarchy restart herdr"},
  "personal.omarchy.tmux": {"icon":"","label":"Restart tmux","description":"omarchy restart tmux","action":"omarchy restart tmux"},

  // Skills: acionam um agente/LLM. game-mode deixa escolher quem analisa
  // (~/.local/bin/game-mode --llm <agente>).
  "personal.skills": {"icon":"","label":"Skills"},
  "personal.skills.autopilot": {"icon":"","label":"Autopilot","description":"Codex $autopilot: entrega objetivo com plano, subagentes, revisão e validação","action":"omarchy agent prompt '$autopilot '"},
  "personal.skills.game-mode": {"icon":"","label":"Game Mode"},
  "personal.skills.game-mode.claude": {"icon":"","label":"Claude","description":"game-mode --llm claude","action":"omarchy-launch-tui game-mode --llm claude"},
  "personal.skills.game-mode.codex": {"icon":"","label":"Codex","description":"game-mode --llm codex","action":"omarchy-launch-tui game-mode --llm codex"},
  "personal.skills.game-mode.agy": {"icon":"","label":"Antigravity (agy)","description":"game-mode --llm agy","action":"omarchy-launch-tui game-mode --llm agy"},
  "personal.skills.game-mode.openclaw": {"icon":"","label":"OpenClaw","description":"game-mode --llm openclaw","action":"omarchy-launch-tui game-mode --llm openclaw"},
  "personal.skills.game-mode.none": {"icon":"","label":"Sem LLM","description":"game-mode --llm none","action":"omarchy-launch-tui game-mode --llm none"},
}
